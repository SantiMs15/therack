---
import Layout from '../../layouts/Layout.astro'
import RejillaProductos from '../../components/RejillaProductos.astro'
import { productos } from '../../data/productos'
import { descuento } from '../../data/schema'
import { marcasQueQuepan, marcasPorPeso, saleDe, tarjetasEnOrden } from '../../lib/catalogo'
import {
  fichaCategoria,
  fichaMigas,
  serializar,
  type Miga,
} from '../../lib/datos-estructurados'
import { VENTA } from '../../config'

/**
 * /sale/: las prendas rebajadas, las que tienen `precioAntes`.
 *
 * Se publica SIEMPRE, haya rebajas o no: Sale es una seccion de la tienda y
 * la cabecera la enlaza desde todas las paginas. Sin rebajas se queda con un
 * aviso y con noindex: un buscador no tiene nada que ensenar de ella, y una
 * pagina vacia indexada resta al sitio entero. Tampoco entra en el sitemap
 * (ver astro.config.mjs). El dia que se rebaje algo vuelve a ser indexable
 * sola.
 */
const rebajadas = saleDe(productos)
const hayRebajas = rebajadas.length > 0

// "hasta −40 %" y no un porcentaje por prenda: en una linea de resultado de
// busqueda cabe un dato, y el que hace clicar es el mayor.
const cierre = `Envío gratis a toda Colombia en ${VENTA.entrega.minimo} a ${VENTA.entrega.maximo} días.`
const descripcion = hayRebajas
  ? marcasQueQuepan(
      marcasPorPeso(rebajadas),
      (lista) =>
        `Sale: ${lista} con hasta ${Math.max(...rebajadas.map((p) => descuento(p)!))} % de descuento. ${cierre}`
    )
  : 'Sale de The Rack store: ropa de marca con descuento. Ahora mismo no hay rebajas.'

if (!Astro.site) {
  throw new Error('Astro.site no esta definido: revisa el campo `site` en astro.config.mjs')
}
const migas: Miga[] = [{ nombre: 'Inicio', ruta: '/' }, { nombre: 'Sale' }]
const migasJson = serializar(fichaMigas(migas, Astro.site))

// Mismo listado que las categorias, desde la misma funcion que ordena la
// rejilla: lo que se declara es lo que se ve, en su orden. Vacia no se
// declara: un listado sin elementos no dice nada.
const listadoJson = hayRebajas
  ? serializar(
      fichaCategoria({
        nombre: 'Sale',
        descripcion,
        url: new URL('/sale/', Astro.site).href,
        urls: tarjetasEnOrden(rebajadas).map(
          ({ producto, variante }) =>
            new URL(`/producto/${producto.slug}/${variante.slug}/`, Astro.site).href
        ),
      })
    )
  : null
---
<Layout titulo="Sale: ropa de marca con descuento" descripcion={descripcion} indexable={hayRebajas}>
  <script type="application/ld+json" is:inline set:html={migasJson}></script>
  {listadoJson && <script type="application/ld+json" is:inline set:html={listadoJson}></script>}

  <div class="contenedor catalogo-pagina">
    {/* Oculto a la vista por lo mismo que en la portada y las categorias: es
        la misma rejilla con otras prendas, y un titular que las otras no
        tienen haria saltar la composicion. La seccion ya se ve marcada en la
        cabecera. */}
    <h1 class="visualmente-oculto">Sale</h1>
    {hayRebajas ? (
      <RejillaProductos productos={rebajadas} ordenable conGeneros={false} />
    ) : (
      <p class="vacio">
        Ahora mismo no hay prendas en rebaja. <a href="/">Mira las Exclusives</a>.
      </p>
    )}
  </div>
</Layout>

<style>
  .catalogo-pagina { padding-block: var(--espacio-2) var(--espacio-4); }
  .vacio {
    color: var(--texto-suave);
    padding-block: var(--espacio-4);
  }
  .vacio a { color: var(--texto); text-underline-offset: 0.35em; }
</style>
