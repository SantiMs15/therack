---
import Layout from '../layouts/Layout.astro'
import { CONFIG, INSTAGRAM_URL, VENTA } from '../config'
import { formatearPrecio } from '../lib/formato'

/**
 * La tienda es solo online, asi que aqui ya no van direccion ni horario de
 * puerta: lo que un cliente necesita saber antes de escribir es cuanto cuesta
 * el envio, cuanto tarda, como se paga y si puede cambiar la prenda. Eso es
 * lo que se responde una y otra vez por WhatsApp.
 */
const envio =
  VENTA.envio.costo === 0
    ? `Gratis a toda Colombia · ${VENTA.entrega.minimo} a ${VENTA.entrega.maximo} días`
    : `${formatearPrecio(VENTA.envio.costo)} · ${VENTA.entrega.minimo} a ${VENTA.entrega.maximo} días`
---
<Layout
  titulo="La tienda"
  descripcion={`Envío gratis a toda Colombia en ${VENTA.entrega.minimo} a ${VENTA.entrega.maximo} días, pago por transferencia y cambios hasta ${VENTA.cambios.dias} días.`}
>
  <div class="contenedor tienda">
    <h1>La tienda</h1>
    <p class="sobre">{CONFIG.sobre}</p>
    <dl>
      <dt>Envíos</dt>
      <dd>{envio}</dd>
      <dt>Pagos</dt>
      <dd>{VENTA.pago.texto}</dd>
      <dt>Cambios</dt>
      <dd>Hasta {VENTA.cambios.dias} días después de recibir la prenda</dd>
      <dt>Atención</dt>
      <dd>{CONFIG.horarios}</dd>
      <dt>Instagram</dt>
      <dd><a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">@{CONFIG.instagram}</a></dd>
    </dl>
  </div>
</Layout>

<style>
  .tienda { padding-block: var(--espacio-3) var(--espacio-4); max-width: 55ch; }
  .sobre { color: var(--texto-suave); margin-top: var(--espacio-2); }
  dl { margin-top: var(--espacio-3); }
  dt {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--texto-suave);
    margin-top: var(--espacio-2);
  }
  dd { margin: 0; }
  dd a { text-decoration: underline; }
</style>
