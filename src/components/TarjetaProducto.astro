---
import { Image } from 'astro:assets'
import { nombreMarca, ultimaTalla, type Producto, type Variante } from '../data/schema'
import { resolverImagen } from '../lib/imagenes-productos'
import Precio from './Precio.astro'

interface Props {
  producto: Producto
  variante: Variante
  /** Se descarga sin esperar a estar en pantalla: las primeras filas. */
  prioridad?: boolean
  /**
   * La que probablemente sea el elemento mas grande de la primera pantalla.
   * Solo UNA por pagina: fetchpriority reparte el ancho de banda, y marcar
   * cuatro como altas es no marcar ninguna -- compiten entre si y la que de
   * verdad manda llega mas tarde que si solo estuviera ella.
   */
  principal?: boolean
  /**
   * La marca que se lee bajo el nombre, si no es la de la prenda. En la pagina
   * de una marca una colaboracion firma solo con esa marca: la otra ya la dice
   * el nombre de la prenda, y repetirla parece otra prenda.
   */
  marcaVisible?: string
}
const { producto, variante, prioridad = false, principal = false, marcaVisible } = Astro.props

const marca = nombreMarca(producto)
const alternativoPorDefecto = [marca, producto.nombre, variante.color]
  .filter(Boolean)
  .join(' ')

// Se pintan TODAS las fotos de la variante para poder rotarlas en la rejilla.
// Sin alt propio se compone uno con marca y color: "Classic Printed Crew Neck"
// repetido en las ocho tarjetas no dice nada ni a un lector de pantalla ni a
// un buscador.
const fotos = variante.imagenes.map((foto) => ({
  datos: resolverImagen(foto.archivo),
  alt: foto.alt ?? alternativoPorDefecto,
}))

// La rejilla puede abrir por una foto distinta a la que abre la ficha: hay
// prendas que se venden por la espalda. Sin `portada` manda la primera.
const indiceInicial = Math.max(0, variante.imagenes.findIndex((i) => i.portada))
const enlace = `/producto/${producto.slug}/${variante.slug}/`

// Si la prenda esta agotada no hay ultima talla que anunciar: lo que falta ya
// lo dice el aviso de abajo, y dos avisos sobre la misma foto se estorban.
const ultima = variante.disponible ? ultimaTalla(producto, variante) : null
---
<article class="tarjeta">
  <div class="marco" data-galeria data-indice={indiceInicial} data-inicial={indiceInicial}>
    {fotos.map((foto, i) => (
      <Image
        class:list={['foto', { activa: i === indiceInicial }]}
        src={foto.datos}
        alt={foto.alt}
        widths={[300, 600, 900]}
        sizes="(max-width: 767px) 50vw, 33vw"
        loading={prioridad && i === indiceInicial ? 'eager' : 'lazy'}
        fetchpriority={principal && i === indiceInicial ? 'high' : undefined}
      />
    ))}

    {ultima && <span class="ultima-talla">Última talla</span>}

    {!variante.disponible && <span class="agotado">Agotado</span>}

  </div>

  <h3 class="nombre">
    {/* El enlace envuelve solo el titulo, pero su ::after cubre la tarjeta
        entera: asi toda la pieza es clicable. */}
    <a class="enlace" href={enlace}>{producto.nombre} - {variante.color}</a>
  </h3>
  {(marcaVisible ?? marca) && <p class="marca">{marcaVisible ?? marca}</p>}
  <Precio producto={producto} variante={variante} />
</article>

<style>
  .tarjeta { position: relative; display: block; }

  .marco {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--linea);
    /* El gesto horizontal sobre la foto es nuestro; el vertical se queda con
       el navegador, que si no la rejilla no se podria recorrer con el dedo. */
    touch-action: pan-y;
  }

  /* Las fotos se apilan y se cruzan por opacidad. Apilarlas en vez de moverlas
     evita reflow al rotar y deja el alto de la tarjeta fijo. */
  .marco :global(.foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* Lento a proposito: al pasar el raton la foto se funde en la siguiente,
       sin saltar. */
    transition: opacity 600ms ease, transform 600ms ease;
  }
  .marco :global(.foto.activa) { opacity: 1; }
  .tarjeta:hover .marco :global(.foto) { transform: scale(1.03); }

  /* El unico color de la paleta, gastado donde tiene que frenar al que
     recorre la rejilla. Etiqueta pequena y arriba a la izquierda: no tapa la
     prenda, no choca con el aviso de agotado (abajo), y aun asi se ve antes que el
     precio. */
  .ultima-talla {
    position: absolute;
    z-index: 2;
    inset-block-start: 0;
    inset-inline-start: 0;
    background: var(--burdeos);
    color: var(--fondo);
    /* Geist, la sans que ya usa el nombre de marca en la tarjeta. A 11px y en
       versalitas la typewriter emborrona los remates, y encima de un relleno
       burdeos hay que leerla de un vistazo. El peso 500 es la excepcion al
       400 del resto del sitio: texto claro sobre fondo oscuro y muy pequeno
       adelgaza, y esto tiene que frenar al que recorre la rejilla. */
    font-family: var(--fuente-marca);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.5rem;
  }

  .agotado {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: 2;
    background: var(--texto);
    color: var(--fondo);
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-block: var(--espacio-1);
  }

  /* Nombre, marca y precio centrados bajo la foto. */
  .nombre,
  .marca,
  .precio { text-align: center; }

  .nombre {
    font-family: var(--fuente-ui);
    font-size: 0.9375rem;
    font-weight: 400;
    margin-block: var(--espacio-2) 0;
  }
  .enlace::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .marca {
    font-family: var(--fuente-marca);
    margin-block: 0.375rem 0;
    color: var(--texto-suave);
    font-size: 0.8125rem;
  }
  /* El precio cierra la tarjeta, asi que va mas grande que el nombre y con
     mas aire por encima: es el dato que el cliente busca al recorrer la
     rejilla. */
  .precio {
    margin-block: var(--espacio-1) 0;
    color: var(--texto);
    font-size: 1.0625rem;
  }
  /* Con rebaja el precio es una fila flexible; centrada como el resto. */
  .precio { justify-content: center; }
</style>

<script>
  // Por debajo de esto el dedo no queria pasar de foto, solo tocar la tarjeta.
  const UMBRAL = 40

  function rotar(marco: HTMLElement, paso: number) {
    const total = marco.querySelectorAll('.foto').length
    const actual = Number(marco.dataset.indice ?? 0)
    // Modulo con correccion de signo: en JS -1 % 3 es -1, no 2.
    mostrar(marco, (((actual + paso) % total) + total) % total)
  }

  function mostrar(marco: HTMLElement, indice: number) {
    const fotos = marco.querySelectorAll<HTMLImageElement>('.foto')
    const actual = Number(marco.dataset.indice ?? 0)
    if (fotos.length < 2 || indice === actual) return

    fotos[actual]?.classList.remove('activa')
    fotos[indice]?.classList.add('activa')
    marco.dataset.indice = String(indice)
  }

  // --- Pasar el raton ---
  // Al entrar en la tarjeta se funde en la foto siguiente a la de portada; al
  // salir vuelve a la portada. Solo con raton: en tactil el toque emula un
  // pointerover y cambiaria la foto justo antes de abrir la ficha.
  // Delegacion en el documento: una sola escucha para todas las tarjetas.
  function marcoDe(evento: PointerEvent): HTMLElement | null {
    if (evento.pointerType !== 'mouse') return null
    const tarjeta = (evento.target as HTMLElement).closest<HTMLElement>('.tarjeta')
    // Moverse entre hijos de la misma tarjeta tambien dispara over/out.
    if (!tarjeta || tarjeta.contains(evento.relatedTarget as Node | null)) return null
    return tarjeta.querySelector<HTMLElement>('[data-galeria]')
  }

  document.addEventListener('pointerover', (evento) => {
    const marco = marcoDe(evento)
    if (!marco) return
    const fotos = marco.querySelectorAll('.foto').length
    mostrar(marco, (Number(marco.dataset.inicial ?? 0) + 1) % fotos)
  })

  document.addEventListener('pointerout', (evento) => {
    const marco = marcoDe(evento)
    if (marco) mostrar(marco, Number(marco.dataset.inicial ?? 0))
  })

  // --- Deslizar con el dedo ---
  // El equivalente tactil de pasar el raton. El raton se queda fuera a
  // proposito: a el le basta con entrar en la tarjeta.
  let marcoActivo: HTMLElement | null = null
  let inicioX = 0
  let inicioY = 0
  let ultimoDeslizamiento = 0

  document.addEventListener('pointerdown', (evento) => {
    if (evento.pointerType === 'mouse') return
    marcoActivo = (evento.target as HTMLElement).closest<HTMLElement>('[data-galeria]')
    inicioX = evento.clientX
    inicioY = evento.clientY
  })

  document.addEventListener('pointerup', (evento) => {
    const marco = marcoActivo
    marcoActivo = null
    if (!marco) return

    const dx = evento.clientX - inicioX
    const dy = evento.clientY - inicioY
    // Corto, o mas vertical que horizontal: era un toque o un scroll.
    if (Math.abs(dx) < UMBRAL || Math.abs(dx) <= Math.abs(dy)) return

    // Arrastrar a la izquierda trae la foto siguiente, como pasar una hoja.
    rotar(marco, dx < 0 ? 1 : -1)
    ultimoDeslizamiento = Date.now()
  })

  // El navegador cancela el puntero en cuanto decide que el gesto es scroll.
  document.addEventListener('pointercancel', () => { marcoActivo = null })

  // El enlace de la tarjeta la cubre entera con su ::after, asi que al soltar
  // el dedo se abriria tambien la ficha. Ese clic se traga en captura, antes
  // de que llegue a nadie.
  document.addEventListener(
    'click',
    (evento) => {
      if (Date.now() - ultimoDeslizamiento > 400) return
      evento.preventDefault()
      evento.stopPropagation()
    },
    true
  )
</script>
