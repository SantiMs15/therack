---
/**
 * GALERIA ELASTICA: un acordeon de fotos que se abre hacia la que se mira.
 *
 * Una foto abierta ocupa cuatro partes del ancho y las demas una cada una.
 * Pasar el raton, tocar o llegar con el tabulador abre otra: las tres cosas
 * hacen lo mismo porque en movil no hay hover y con teclado no hay puntero.
 *
 * El HTML sale completo del servidor con la primera del medio abierta, asi
 * que sin JS la galeria se ve igual -- solo deja de cambiar.
 */
import { Image } from 'astro:assets'
import { resolverImagenMarca } from '../lib/imagenes-marcas'
import type { FichaMarca } from '../data/fichas-marca'

interface Props {
  fotos: NonNullable<FichaMarca['galeria']>
}

const { fotos } = Astro.props
/* Abre la del medio: con las cerradas a los dos lados se entiende de un
   vistazo que las demas tambien se abren. */
const inicial = Math.floor(fotos.length / 2)
---

<div class="galeria" data-galeria>
  {fotos.map((foto, i) => (
    <figure class="galeria__item" data-activa={i === inicial ? '' : undefined} tabindex="0">
      {/* La columna abierta en desktop mide como mucho ~ media pagina, y en
          movil la ventana entera. */}
      <Image
        class="galeria__foto"
        src={resolverImagenMarca(foto.imagen)}
        alt={foto.alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 40vw, 100vw"
      />
    </figure>
  ))}
</div>

<script>
  for (const galeria of document.querySelectorAll<HTMLElement>('[data-galeria]')) {
    const items = galeria.querySelectorAll<HTMLElement>('.galeria__item')
    const abrir = (item: HTMLElement) => {
      for (const otro of items) otro.toggleAttribute('data-activa', otro === item)
    }
    for (const item of items) {
      item.addEventListener('mouseenter', () => abrir(item))
      item.addEventListener('click', () => abrir(item))
      item.addEventListener('focus', () => abrir(item))
    }
  }
</script>

<style>
  .galeria {
    --curva: cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    flex-direction: column;
    gap: var(--espacio-1);
    height: 500px;
  }

  @media (min-width: 900px) {
    .galeria {
      flex-direction: row;
      gap: var(--espacio-2);
      height: 600px;
    }
  }

  .galeria__item {
    position: relative;
    flex: 1;
    /* Sin esto el flex-item no baja de lo que mide la foto dentro y las
       cerradas no llegan a cerrarse. */
    min-width: 0;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    cursor: pointer;
    background: var(--texto);
    filter: brightness(0.5);
    transition: flex 700ms var(--curva), filter 700ms var(--curva);
  }

  .galeria__item:hover { filter: brightness(0.75); }

  .galeria__item[data-activa] {
    flex: 4;
    filter: brightness(1);
  }

  .galeria__item:focus-visible {
    outline: 2px solid var(--texto);
    outline-offset: 3px;
  }

  .galeria__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
    transition: transform 1000ms var(--curva);
  }

  .galeria__item[data-activa] .galeria__foto { transform: scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .galeria__item,
    .galeria__foto { transition: none; }
  }
</style>
