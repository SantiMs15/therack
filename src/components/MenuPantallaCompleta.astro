---
/**
 * Menu a pantalla completa: boton en la cabecera que despliega un panel con
 * los enlaces que se le pasen.
 *
 * No sabe que lista pinta: recibe `enlaces` y un `id` propio. Hoy la cabecera
 * monta uno solo, el del archivo de marcas; la lista vive en Layout.astro,
 * que es donde se decide que ensena la cabecera.
 *
 * Portado de un componente React + GSAP conservando su comportamiento (capas
 * de fondo escalonadas, enlaces que suben rotando, icono que gira, texto del
 * boton que cambia) pero resuelto con transiciones CSS. React y GSAP habrian
 * anadido unos 70 KB comprimidos a cada pagina de un sitio que hoy no envia
 * ningun archivo JavaScript; el escalonado se consigue con transition-delay.
 *
 * La paleta se pasa a la del sitio: el original usaba indigo, violeta y rosa,
 * que el spec y el DESIGN.md del proyecto prohiben expresamente.
 */
export interface Enlace {
  href: string
  texto: string
  /** Se descuelga del bloque: no es una entrada mas de la lista de arriba. */
  aparte?: boolean
}

interface Props {
  /** Id del panel. Lo apunta el aria-controls del boton, y con dos menus en
      la misma pagina es lo que empareja cada boton con el suyo. */
  id: string
  /** Texto del boton y nombre del panel para el lector de pantalla. */
  rotulo: string
  enlaces: Enlace[]
}

const { id, rotulo, enlaces } = Astro.props

/**
 * Con pocas entradas las dos columnas de escritorio parten una lista que ya
 * cabia de sobra en una: se reservan para el archivo, que pasa de veinte.
 */
const enColumnas = enlaces.length > 8
---

<button
  type="button"
  class="boton-menu"
  aria-expanded="false"
  aria-controls={id}
  data-menu-boton
>
  <span class="boton-menu__textos">
    <span>{rotulo}</span>
    <span>Cerrar</span>
  </span>
  <span class="boton-menu__icono" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" width="16" height="16">
      <path d="M7.33333 16L7.33333 0L8.66667 0L8.66667 16L7.33333 16Z" fill="currentColor" />
      <path d="M16 8.66667L0 8.66667L0 7.33333L16 7.33333L16 8.66667Z" fill="currentColor" />
    </svg>
  </span>
</button>

<div class="menu" id={id} data-menu data-estado="cerrado">
  <div class="menu__velo" data-menu-cerrar></div>

  <nav class="menu__panel" aria-label={rotulo}>
    <span class="menu__capa" aria-hidden="true"></span>
    <span class="menu__capa" aria-hidden="true"></span>
    <span class="menu__capa" aria-hidden="true"></span>

    {/* El que desplaza es este, no el panel: las tres capas de fondo son
        hermanas de la lista y estan posicionadas contra el panel, asi que si
        el que se moviera fuera el panel se irian con el texto y dejarian el
        hueco a la vista. */}
    <div class="menu__desplazable">
    <ul class:list={['menu__lista', { 'menu__lista--columnas': enColumnas }]}>
      {enlaces.map((e, i) => (
        <li
          class:list={['menu__item', { 'menu__item--aparte': e.aparte }]}
          style={`--i: ${i}`}
        >
          <a href={e.href} class="menu__enlace"><span>{e.texto}</span></a>
        </li>
      ))}
    </ul>
    </div>
  </nav>
</div>

<style>
  /* --- Boton --- */
  .boton-menu {
    /* El panel del menu es hijo de la cabecera y va posicionado; sin un
       z-index propio el boton se pintaria por debajo de el y quedaria
       intocable con el menu abierto. */
    position: relative;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-1);
    background: none;
    border: 0;
    padding: 0.25rem 0;
    color: var(--texto);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  /* Las dos palabras se apilan y el bloque sube una linea al abrir: se ve
     "Menu" cerrado y "Cerrar" abierto, sin cambiar el texto por JavaScript. */
  .boton-menu__textos {
    display: block;
    height: 1.5em;
    overflow: hidden;
    line-height: 1.5em;
  }
  .boton-menu__textos span {
    display: block;
    /* Sin esto, "Archivo de marcas" se partiria en dos lineas dentro de un
       bloque de 1.5em con overflow oculto: la segunda linea se cortaria a
       media altura en vez de empujar el boton. */
    white-space: nowrap;
    transition: transform 400ms cubic-bezier(0.65, 0.01, 0.05, 0.99);
  }
  /* El nombre del boton es largo y el logo mide 200 px fijos: en movil los
     dos no caben en la misma fila al tamano de escritorio y la cabecera se
     partia en dos. Se encoge el boton, no el nombre. A 12 px cabe desde los
     375 px de ancho; por debajo de eso la cabecera vuelve a dos filas, que es
     preferible a bajar mas la letra de un boton principal. */
  @media (max-width: 480px) {
    .boton-menu { font-size: 0.75rem; }
  }
  /* Con el menu abierto el boton queda sobre el panel oscuro: sin invertir
     el color seria texto #111 sobre negro, ilegible. */
  .boton-menu[aria-expanded='true'] {
    color: var(--fondo);
  }
  .boton-menu[aria-expanded='true'] .boton-menu__textos span {
    transform: translateY(-100%);
  }

  .boton-menu__icono {
    display: inline-flex;
    transition: transform 500ms cubic-bezier(0.65, 0.01, 0.05, 0.99);
  }
  /* 315 grados y no 45: la cruz gira dando casi una vuelta completa, que es
     lo que hacia el original. */
  .boton-menu[aria-expanded='true'] .boton-menu__icono {
    transform: rotate(315deg);
  }

  /* --- Contenedor --- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 20;
    visibility: hidden;
    /* visibility no se interpola, asi que se retrasa hasta que termina la
       salida. Sin este retardo el panel desaparecia de golpe y la animacion
       de cierre no llegaba a verse. */
    transition: visibility 0s linear 1000ms;
  }
  .menu[data-estado='abierto'] {
    visibility: visible;
    transition: visibility 0s linear 0s;
  }

  .menu__velo {
    position: absolute;
    inset: 0;
    background: rgba(17, 17, 17, 0.4);
    opacity: 0;
    transition: opacity 500ms cubic-bezier(0.65, 0.01, 0.05, 0.99);
  }
  .menu[data-estado='abierto'] .menu__velo {
    opacity: 1;
  }

  /* --- Panel --- */
  .menu__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: min(100%, 34rem);
    display: flex;
    align-items: center;
    padding: var(--espacio-4) var(--espacio-3);
    transform: translateX(101%);
    transition: transform 575ms cubic-bezier(0.65, 0.01, 0.05, 0.99);
  }
  .menu[data-estado='abierto'] .menu__panel {
    transform: translateX(0);
  }

  /* Dos columnas piden ancho: "Maison Mihara Yasuhiro" partida en dos lineas
     no se lee como un nombre. */
  @media (min-width: 768px) {
    .menu__panel { width: min(100%, 44rem); }
  }

  /* La lista es mas alta que la ventana en un movil, y en un portatil bajo
     tambien con dos columnas. `contain` para que al llegar al final no siga
     desplazandose la pagina de debajo. */
  .menu__desplazable {
    position: relative;
    width: 100%;
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .menu__desplazable::-webkit-scrollbar { display: none; }

  /* Tres capas que entran escalonadas detras del panel. En el original eran
     paneles de color; aqui son tonos del propio sistema, que es lo que deja
     la sensacion de profundidad sin meter un color de acento. */
  .menu__capa {
    position: absolute;
    inset: 0;
    transform: translateX(101%);
    transition: transform 575ms cubic-bezier(0.65, 0.01, 0.05, 0.99);
  }
  .menu__capa:nth-child(1) { background: var(--texto-suave); }
  .menu__capa:nth-child(2) { background: #2A2724; transition-delay: 120ms; }
  .menu__capa:nth-child(3) { background: var(--texto); transition-delay: 240ms; }

  .menu[data-estado='abierto'] .menu__capa {
    transform: translateX(0);
  }

  /* --- Lista --- */
  .menu__lista {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  /* Veintiseis marcas no caben en una columna a tamano de titular: serian dos
     pantallas y media de alto y habria que bajar para ver la mitad. Dos
     columnas desde tablet, con la lista partida por altura, que es como se
     lee un indice. La entrada aparte -- Tienda -- se saca de las columnas
     para que siga colgando debajo de todo. */
  @media (min-width: 768px) {
    .menu__lista--columnas { columns: 2; column-gap: var(--espacio-4); }
    .menu__lista--columnas .menu__item { break-inside: avoid; }
    .menu__lista--columnas .menu__item--aparte { column-span: all; }
  }

  /* Cada enlace vive en una ventana que recorta: el texto sube desde abajo
     rotando ligeramente, como en el original. */
  .menu__item { overflow: hidden; }

  .menu__enlace {
    display: block;
    color: var(--fondo);
    font-family: var(--fuente-titular);
    /* Mas corto que un titular: la lista es larga y a 3,5rem cada marca
       ocupaba una linea de pantalla entera. */
    font-size: clamp(1.25rem, 3.2vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    padding-block: 0.15em;
  }
  .menu__enlace span {
    display: block;
    transform: translateY(140%) rotate(10deg);
    transition:
      transform 700ms cubic-bezier(0.65, 0.01, 0.05, 0.99),
      opacity 700ms cubic-bezier(0.65, 0.01, 0.05, 0.99);
    opacity: 0;
  }
  .menu[data-estado='abierto'] .menu__enlace span {
    transform: translateY(0) rotate(0deg);
    opacity: 1;
  }

  /* Escalonado: cada enlace entra despues del anterior, tras la entrada del
     panel. El indice lo pone el marcado en `--i`, no una regla por posicion:
     con veintisiete entradas habria que escribir veintisiete reglas, y la
     primera marca que entrase al catalogo dejaria la ultima sin retardo.

     20 ms por entrada y no 60: a 60 la ultima esperaria dos segundos largos.
     `min` corta el escalonado a los 600 ms, asi que las de mas abajo entran
     juntas -- y son las que quedan fuera de la primera mirada. */
  .menu__item .menu__enlace span {
    transition-delay: calc(350ms + min(var(--i, 0) * 20ms, 600ms));
  }

  /* Tienda no es una marca: baja a la typewriter de la interfaz y se
     descuelga del bloque, para que la vista no la cuente como una mas de la
     lista de arriba. */
  .menu__item--aparte { margin-block-start: var(--espacio-3); }
  .menu__item--aparte .menu__enlace {
    font-family: var(--fuente-ui);
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }

  .menu__enlace:hover span { opacity: 0.55; }
  .menu__enlace:focus-visible { outline: 2px solid var(--fondo); outline-offset: 4px; }

  /* --- Cierre: el reflejo de la apertura --- */
  /* Al abrir entra primero el panel y despues los enlaces. Al cerrar se
     invierte: salen los enlaces escalonados y solo entonces se retira el
     panel, en vez de desvanecerse todo a la vez. */
  /* Al cerrar no se escalona: veintisiete salidas encadenadas retrasarian el
     panel casi un segundo, y cerrar tiene que sentirse inmediato. Salen todas
     a la vez y el panel se retira detras. */
  .menu[data-estado='cerrado'] .menu__item .menu__enlace span { transition-delay: 0ms; }

  /* El panel y sus capas esperan a que los enlaces hayan salido. */
  .menu[data-estado='cerrado'] .menu__panel { transition-delay: 340ms; }
  .menu[data-estado='cerrado'] .menu__capa:nth-child(1) { transition-delay: 460ms; }
  .menu[data-estado='cerrado'] .menu__capa:nth-child(2) { transition-delay: 400ms; }
  .menu[data-estado='cerrado'] .menu__capa:nth-child(3) { transition-delay: 340ms; }
  .menu[data-estado='cerrado'] .menu__velo { transition-delay: 400ms; }
</style>

<script>
  // Unico JavaScript de este componente: abrir, cerrar y devolver el foco.
  // La animacion entera vive en CSS.
  //
  // El panel se busca por el aria-controls del boton y no por [data-menu]: el
  // id lo pone quien monta el componente, asi que el emparejamiento sigue
  // siendo el correcto el dia que la cabecera monte un segundo menu.
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]')
  const menu = document.getElementById(boton?.getAttribute('aria-controls') ?? '')

  if (boton && menu) {
    const enlaces = menu.querySelectorAll<HTMLAnchorElement>('.menu__enlace')

    const abrir = (si: boolean) => {
      menu.dataset.estado = si ? 'abierto' : 'cerrado'
      // La cabecera es un ancestro y CSS no puede seleccionar hacia arriba:
      // se marca el estado en <body> para que pueda volverse transparente.
      document.body.dataset.menu = si ? 'abierto' : 'cerrado'
      boton.setAttribute('aria-expanded', String(si))
      // Con el menu cerrado sus enlaces siguen en el DOM: sin esto, tabular
      // los recorreria estando invisibles.
      enlaces.forEach((a) => a.setAttribute('tabindex', si ? '0' : '-1'))
      document.body.style.overflow = si ? 'hidden' : ''
      if (si) enlaces[0]?.focus()
      else boton.focus()
    }

    abrir(false)

    boton.addEventListener('click', () => abrir(menu.dataset.estado !== 'abierto'))
    menu
      .querySelector<HTMLElement>('[data-menu-cerrar]')
      ?.addEventListener('click', () => abrir(false))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.dataset.estado === 'abierto') abrir(false)
    })
  }
</script>
