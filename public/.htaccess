# Configuracion para hosting Apache (Hostinger).
# Astro copia public/ tal cual a dist/, asi que este archivo viaja con el sitio.

# --- Un solo dominio ---
# www.therackstore.shop servia el sitio entero con un 200, asi que habia dos
# direcciones publicando lo mismo. El canonical ya apuntaba al dominio sin
# www, pero un canonical es una sugerencia y un 301 no: esto deja una sola
# puerta, y de paso los enlaces que alguien comparta con www pasan su valor
# a la buena en vez de quedarse a medias.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# --- URLs viejas de las fichas ---
# Las fichas pasaron a llevar la marca delante del nombre (marca-producto),
# la misma regla que los nombres de las fotos. Las URLs de antes ya estaban
# compartidas por WhatsApp e Instagram y algunas en Google: el 301 las
# manda a la nueva con el color incluido, y le dice a Google que traslade lo
# que tuvieran. No borrar aunque parezca que ya nadie las usa: un enlace
# viejo en un chat no caduca.
#
# `(/.*)?` y no `/(.*)`: tambien entra la URL sin barra ni color.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^producto/intarsia-wool-sweater(/.*)?$ /producto/lacoste-intarsia-wool-sweater$1 [R=301,L]
  RewriteRule ^producto/multi-print-fleece-hoodie(/.*)?$ /producto/lacoste-multi-print-fleece-hoodie$1 [R=301,L]
  RewriteRule ^producto/striped-cable-knit-polo(/.*)?$ /producto/lacoste-striped-cable-knit-polo$1 [R=301,L]
  RewriteRule ^producto/crew-neck-lacoste(/.*)?$ /producto/lacoste-classic-printed-crew-neck$1 [R=301,L]
  RewriteRule ^producto/classic-quarter-zip-sweater(/.*)?$ /producto/tommy-hilfiger-classic-quarter-zip-sweater$1 [R=301,L]
  RewriteRule ^producto/quarter-zip-sweater(/.*)?$ /producto/tommy-hilfiger-quarter-zip-sweater$1 [R=301,L]
  RewriteRule ^producto/crewneck-favorite-t-shirt(/.*)?$ /producto/tommy-hilfiger-crewneck-favorite-t-shirt$1 [R=301,L]
  RewriteRule ^producto/mixed-media-puffer-jacket(/.*)?$ /producto/tommy-hilfiger-mixed-media-puffer-jacket$1 [R=301,L]
  RewriteRule ^producto/unisphere-tee(/.*)?$ /producto/aime-leon-dore-unisphere-tee$1 [R=301,L]
  RewriteRule ^producto/unisphere-waffle-thermal(/.*)?$ /producto/aime-leon-dore-unisphere-waffle-thermal$1 [R=301,L]
  RewriteRule ^producto/souvenir-tee(/.*)?$ /producto/aime-leon-dore-souvenir-tee$1 [R=301,L]
  RewriteRule ^producto/geo-print-crewneck(/.*)?$ /producto/aime-leon-dore-new-balance-geo-print-crewneck$1 [R=301,L]
  RewriteRule ^producto/astronaut-tee(/.*)?$ /producto/kidsuper-studios-astronaut-tee$1 [R=301,L]
  RewriteRule ^producto/twitch-studded-crewneck-t-shirt(/.*)?$ /producto/pleasures-twitch-studded-crewneck-t-shirt$1 [R=301,L]
  RewriteRule ^producto/pinstripe-night-sky-knit-sweater(/.*)?$ /producto/eme-studios-pinstripe-night-sky-knit-sweater$1 [R=301,L]

  # Prendas retiradas: su enlace sigue en chats, asi que lleva a la marca en
  # vez de a un 404. La tarjeta de compartir (/tarjeta/...) tambien.
  RewriteRule ^(producto|tarjeta)/diesel-oval-d-sleeve-sweatshirt(/.*)?$ /marca/diesel/ [R=301,L]
</IfModule>

# Sirve la pagina 404 propia (con logo y salida al catalogo) en vez de la
# generica del hosting.
ErrorDocument 404 /404.html

# Los archivos de /_astro/ llevan un hash en el nombre: si cambia el contenido
# cambia el nombre, asi que cachearlos un ano es seguro. El HTML no se cachea,
# para que un catalogo actualizado se vea al instante.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|woff|woff2|css|js)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # HTTP ya redirige a HTTPS, pero esa primera peticion viaja en claro. Con
  # esta cabecera el navegador deja de intentarlo: se ahorra el salto y no hay
  # ventana que interceptar.
  #
  # OJO: el navegador lo recuerda un ano y NO se puede cancelar antes. Si el
  # certificado caducara, quien ya la haya recibido no puede entrar por HTTP:
  # veria un error, no la version sin cifrar. Con el certificado renovandose
  # solo esto no pasa, pero conviene saberlo. Sin `preload`, que si seria
  # irreversible de verdad.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|woff|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
